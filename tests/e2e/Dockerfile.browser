FROM node:22.22.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --prefix /opt/browser --no-audit --no-fund playwright-core@1.56.1 \
    && npm cache clean --force
ENV NODE_PATH=/opt/browser/node_modules
WORKDIR /tests
COPY tests/e2e/browser.test.js ./browser.test.js
CMD ["node", "--test", "browser.test.js"]
