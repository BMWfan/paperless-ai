FROM ollama/ollama:0.12.6
ARG QUALITY_MODEL=qwen2.5:0.5b
COPY tests/quality/model-locks /tmp/quality-model-locks
RUN ollama serve >/tmp/ollama-build.log 2>&1 & server=$!; \
    trap 'kill "$server"' EXIT; \
    case "$QUALITY_MODEL" in qwen2.5:0.5b) quality_lock=/tmp/quality-model-locks/qwen05b.sha256;; qwen2.5:1.5b) quality_lock=/tmp/quality-model-locks/qwen15b.sha256;; *) exit 1;; esac; \
    for attempt in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 1; done; \
    ollama pull "$QUALITY_MODEL" && sha256sum -c "$quality_lock"
