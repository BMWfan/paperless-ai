  "qualification": {
    "minimumPositiveIdentifierCoverage": 0.8,
    "maximumWrongAcceptedIdentifiers": 0,
    "requireNoIdentifierCoverageDecline": true,
    "requireNoOtherFieldCorrectPresentDecline": true,
